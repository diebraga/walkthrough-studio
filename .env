# Developer tooling for the walk demo — see docs/dev-settings.md
#
# Default flags when the URL has no ?dev= param and nothing is stored yet.
# Comma-separated: collision, portals. Empty or unset means off.
# Ignored entirely by production builds (gated on import.meta.env.DEV).
#
# For a personal override that is not committed, put VITE_DEV_FLAGS in
# .env.local instead — Vite gives it precedence over this file.
VITE_DEV_FLAGS=collision,portals
